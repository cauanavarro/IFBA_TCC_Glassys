  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* =========================================================
   GLASSYS
   LIGHT THEME
   PySide6 / Qt Widgets
   ========================================================= */


/* =========================================================
   1. ESTILO GERAL
   ========================================================= */

QMainWindow {
    background-color: #F5F7FA;
}

QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #1F2937;
}


/* =========================================================
   2. SIDEBAR
   ========================================================= */

QFrame#sidebarFrame {
    background-color: #1F3342;
    border: none;
    border-right: 1px solid #D9E0E5;
}


/* ---------- Logo ---------- */

QLabel#logoLabel {
    color: #FFFFFF;

    font-size: 27px;
    font-weight: 700;

    background-color: transparent;
    border: none;

    padding-left: 10px;
}


/* ---------- Divisórias ---------- */

QFrame#upperSidebarLine,
QFrame#bottomSidebarLine {
    background-color: #385061;
    color: #385061;

    border: none;

    max-height: 1px;
}


/* ---------- Botões da Sidebar ---------- */

QPushButton#sellButton,
QPushButton#ordersButton,
QPushButton#productsButton,
QPushButton#customersButton,
QPushButton#prescriptionsButton,
QPushButton#statisticsButton,
QPushButton#assistantButton {

    background-color: transparent;

    color: #E8EEF2;

    border: none;
    border-radius: 6px;

    text-align: left;

    padding-left: 16px;
    padding-top: 9px;
    padding-bottom: 9px;

    font-size: 14px;
    font-weight: 500;
}


/* Hover */

QPushButton#sellButton:hover,
QPushButton#ordersButton:hover,
QPushButton#productsButton:hover,
QPushButton#customersButton:hover,
QPushButton#prescriptionsButton:hover,
QPushButton#statisticsButton:hover,
QPushButton#assistantButton:hover {

    background-color: #2B4659;

    color: #FFFFFF;
}


/* Selecionado */

QPushButton#sellButton:checked,
QPushButton#ordersButton:checked,
QPushButton#productsButton:checked,
QPushButton#customersButton:checked,
QPushButton#prescriptionsButton:checked,
QPushButton#statisticsButton:checked,
QPushButton#assistantButton:checked {

    background-color: #365A72;

    color: #FFFFFF;

    font-weight: 600;

    border-left: 3px solid #8EB4CC;

    padding-left: 13px;
}


/* ---------- Usuário ---------- */

QLabel#userNameLabel {
    color: #FFFFFF;

    font-size: 13px;
    font-weight: 600;

    background-color: transparent;
    border: none;

    padding-left: 10px;
}


QLabel#userRoleLabel {
    color: #AFC0CC;

    font-size: 12px;
    font-weight: 400;

    background-color: transparent;
    border: none;

    padding-left: 10px;
}


/* =========================================================
   3. CONTENT FRAME - NOVA VENDA
   ========================================================= */

QFrame#contentFrame {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
}


/* ---------- Título ---------- */

QLabel#pageTitleLabel {
    color: #111827;

    font-size: 32px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* ---------- Títulos de seção ---------- */

QLabel#categoriesLabel,
QLabel#productsLabel {

    color: #111827;

    font-size: 18px;
    font-weight: 600;

    background-color: transparent;
    border: none;
}


/* =========================================================
   4. CAMPO DE BUSCA
   ========================================================= */

QLineEdit#productSearch {

    background-color: #FFFFFF;

    color: #1F2937;

    border: 1px solid #D1D5DB;
    border-radius: 7px;

    padding: 9px 12px;

    font-size: 14px;
}


QLineEdit#productSearch:hover {
    border: 1px solid #9CA3AF;
}


QLineEdit#productSearch:focus {
    background-color: #FFFFFF;

    border: 1px solid #4F7FA3;
}


/* =========================================================
   5. CATEGORIAS
   ========================================================= */

QWidget#categoryContainer {
    background-color: transparent;

    border: none;
}


/* ---------- Botões ---------- */

QPushButton#allCategoriesButton,
QPushButton#frameCategoryButton,
QPushButton#lensCategoryButton,
QPushButton#sunglassesCategoryButton,
QPushButton#contactLensesCategoryButton,
QPushButton#accessoriesCategoryButton {

    background-color: #FFFFFF;

    color: #374151;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    padding: 7px 13px;

    font-size: 13px;
}


QPushButton#allCategoriesButton:hover,
QPushButton#frameCategoryButton:hover,
QPushButton#lensCategoryButton:hover,
QPushButton#sunglassesCategoryButton:hover,
QPushButton#contactLensesCategoryButton:hover,
QPushButton#accessoriesCategoryButton:hover {

    background-color: #F3F6F9;

    color: #24516F;

    border: 1px solid #9CAFC0;
}


QPushButton#allCategoriesButton:pressed,
QPushButton#frameCategoryButton:pressed,
QPushButton#lensCategoryButton:pressed,
QPushButton#sunglassesCategoryButton:pressed,
QPushButton#contactLensesCategoryButton:pressed,
QPushButton#accessoriesCategoryButton:pressed {

    background-color: #E8EEF3;
}


QPushButton#allCategoriesButton:checked,
QPushButton#frameCategoryButton:checked,
QPushButton#lensCategoryButton:checked,
QPushButton#sunglassesCategoryButton:checked,
QPushButton#contactLensesCategoryButton:checked,
QPushButton#accessoriesCategoryButton:checked {

    background-color: #E7F0F7;

    color: #24516F;

    border: 1px solid #7FA4BF;
}


/* =========================================================
   6. ÁREA DOS PRODUTOS
   ========================================================= */

QScrollArea#productScrollArea {

    background-color: #F8F9FA;

    border: 1px solid #E1E5E9;
    border-radius: 8px;
}


QScrollArea#productScrollArea QWidget#qt_scrollarea_viewport {

    background-color: #F8F9FA;

    border-radius: 8px;
}


QWidget#productsContainer {

    background-color: #F8F9FA;

    border: none;
}


/* =========================================================
   8. SALE FRAME - SUA VENDA
   ========================================================= */

QFrame#saleFrame {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
}


/* ---------- Título ---------- */

QLabel#yourSaleLabel {

    color: #111827;

    font-size: 22px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* =========================================================
   9. SALE SCROLL AREA
   ========================================================= */

QScrollArea#saleScrollArea {

    background-color: #F8F9FA;

    border: 1px solid #E1E5E9;
    border-radius: 8px;
}


QScrollArea#saleScrollArea QWidget#qt_scrollarea_viewport {

    background-color: #F8F9FA;

    border-radius: 8px;
}


QWidget#saleLayoutWidgetContents {

    background-color: #F8F9FA;

    border: none;
}


/* =========================================================
   10. SALE ITEM
   ========================================================= */

QFrame#saleItem {

    background-color: #FFFFFF;

    border: 1px solid #E1E5E9;
    border-radius: 9px;
}


/* ---------- Container ---------- */

QWidget#productContainer,
QWidget#productNameAndPrice,
QWidget#productPriceXQuantityWidget,
QWidget#quantityButtons {

    background-color: transparent;

    border: none;
}


/* ---------- Nome ---------- */

QLabel#productNameLabel {

    color: #111827;

    font-size: 15px;
    font-weight: 600;

    background-color: transparent;
    border: none;
}


/* ---------- Preço unitário ---------- */

QLabel#productBasePriceLabel {

    color: #4B5563;

    font-size: 13px;

    background-color: transparent;
    border: none;
}


/* ---------- Quantidade no preço ---------- */

QLabel#productQuantity {

    color: #4B5563;

    font-size: 13px;

    background-color: transparent;
    border: none;
}


/* ---------- Preço total ---------- */

QLabel#productTotalPrice {

    color: #111827;

    font-size: 14px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* ---------- Quantidade ---------- */

QLabel#productQuantityLabel {

    color: #374151;

    font-size: 13px;
    font-weight: 500;

    background-color: transparent;
    border: none;

    min-width: 20px;
}


/* =========================================================
   11. BOTÕES + E -
   ========================================================= */

QPushButton#decreaseButton,
QPushButton#increaseButton {

    background-color: #F3F4F6;

    color: #374151;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    min-width: 30px;
    max-width: 30px;

    min-height: 30px;
    max-height: 30px;

    padding: 0;

    font-size: 14px;
    font-weight: 500;
}


QPushButton#decreaseButton:hover,
QPushButton#increaseButton:hover {

    background-color: #E9EEF2;

    color: #24516F;

    border: 1px solid #B8C5CF;
}


QPushButton#decreaseButton:pressed,
QPushButton#increaseButton:pressed {

    background-color: #DCE6EC;
}


/* =========================================================
   12. REMOVER ITEM
   ========================================================= */

QPushButton#removeItem {

    background-color: #FFFFFF;

    color: #6B7280;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    padding: 6px 11px;

    font-size: 13px;
}


QPushButton#removeItem:hover {

    background-color: #FEF2F2;

    color: #B42318;

    border: 1px solid #F0B4B4;
}


QPushButton#removeItem:pressed {

    background-color: #FEE2E2;
}


/* =========================================================
   13. SUBTOTAL
   ========================================================= */

QWidget#subTotalValueContainer {

    background-color: transparent;

    border: none;
}


QLabel#subtotalLabel {

    color: #111827;

    font-size: 17px;
    font-weight: 600;

    background-color: transparent;
    border: none;
}


QLabel#subtotalValueLabel {

    color: #111827;

    font-size: 17px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* =========================================================
   14. FINALIZAR VENDA
   ========================================================= */

QPushButton#finishSaleButton {

    background-color: #365F7A;

    color: #FFFFFF;

    border: none;
    border-radius: 7px;

    min-height: 38px;

    font-size: 14px;
    font-weight: 600;
}


QPushButton#finishSaleButton:hover {

    background-color: #2E526A;
}


QPushButton#finishSaleButton:pressed {

    background-color: #274657;
}


QPushButton#finishSaleButton:disabled {

    background-color: #CBD5DC;

    color: #F8FAFC;
}


/* =========================================================
   15. SCROLLBARS
   ========================================================= */

QScrollBar:vertical {

    background-color: #F8F9FA;

    width: 10px;

    margin: 4px 3px 4px 0px;

    border: none;

    border-radius: 5px;
}


QScrollBar::handle:vertical {

    background-color: #C7CDD4;

    min-height: 40px;

    border-radius: 5px;
}


QScrollBar::handle:vertical:hover {

    background-color: #AEB7C1;
}


QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;

    border: none;

    background: none;
}


QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {

    background: transparent;
}


/* =========================================================
   16. BOTÕES GENÉRICOS
   =========================================================
   
   Mantido propositalmente no final.
   Os estilos específicos acima têm prioridade por
   utilizarem objectName.
   ========================================================= */

QPushButton {

    background-color: #FFFFFF;

    color: #1F2937;

    border: 1px solid #D1D5DB;

    border-radius: 6px;

    padding: 7px 12px;

    font-size: 13px;
}


QPushButton:hover {

    background-color: #F3F4F6;

    border: 1px solid #B7BEC7;
}


QPushButton:pressed {

    background-color: #E5E7EB;
}


QPushButton:disabled {

    background-color: #F3F4F6;

    color: #9CA3AF;

    border: 1px solid #E5E7EB;
}</string>
