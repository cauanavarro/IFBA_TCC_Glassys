  <property name="styleSheet">
   <string notr="true">/* =========================================================
   SALE ITEM
   ========================================================= */

QFrame#saleItem {
    background-color: #FFFFFF;

    border: 1px solid #E1E5E9;
    border-radius: 9px;
}


/* =========================================================
   CONTAINER DO PRODUTO
   ========================================================= */

QWidget#productContainer {
    background-color: transparent;
    border: none;
}

QWidget#productNameAndPrice {
    background-color: transparent;
    border: none;
}


/* =========================================================
   NOME DO PRODUTO
   ========================================================= */

QLabel#productNameLabel {
    color: #111827;

    font-size: 15px;
    font-weight: 600;

    background-color: transparent;
    border: none;
}


/* =========================================================
   PREÇO UNITÁRIO × QUANTIDADE
   ========================================================= */

QWidget#productPricexQuantityWidget {
    background-color: transparent;
    border: none;
}

QLabel#productBasePriceLabel {
    color: #4B5563;

    font-size: 13px;

    background-color: transparent;
    border: none;
}

QLabel#productQuantity {
    color: #4B5563;

    font-size: 13px;

    background-color: transparent;
    border: none;
}


/* =========================================================
   PREÇO TOTAL DO ITEM
   ========================================================= */

QLabel#productTotalPrice {
    color: #111827;

    font-size: 14px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* =========================================================
   ÁREA DOS BOTÕES
   ========================================================= */

QWidget#quantityButtons {
    background-color: transparent;
    border: none;
}


/* =========================================================
   BOTÃO -
   ========================================================= */

QPushButton#decreaseButton {

    background-color: #F3F4F6;

    color: #374151;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    min-width: 30px;
    max-width: 30px;

    min-height: 30px;
    max-height: 30px;

    padding: 0;

    font-size: 14px;
    font-weight: 500;
}

QPushButton#decreaseButton:hover {

    background-color: #E9EEF2;

    color: #24516F;

    border: 1px solid #B8C5CF;
}

QPushButton#decreaseButton:pressed {

    background-color: #DCE6EC;
}

QPushButton#decreaseButton:disabled {
	color: #C3C3C3
}

/* =========================================================
   BOTÃO +
   ========================================================= */

QPushButton#increaseButton {

    background-color: #F3F4F6;

    color: #374151;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    min-width: 30px;
    max-width: 30px;

    min-height: 30px;
    max-height: 30px;

    padding: 0;

    font-size: 14px;
    font-weight: 500;
}

QPushButton#increaseButton:hover {

    background-color: #E9EEF2;

    color: #24516F;

    border: 1px solid #B8C5CF;
}

QPushButton#increaseButton:pressed {

    background-color: #DCE6EC;
}

QPushButton#increaseButton:disabled {
	color: #C3C3C3
}
/* =========================================================
   QUANTIDADE
   ========================================================= */

QLabel#productQuantityLabel {

    color: #374151;

    font-size: 13px;
    font-weight: 500;

    background-color: transparent;
    border: none;

    min-width: 20px;
}


/* =========================================================
   BOTÃO REMOVER
   ========================================================= */

QPushButton#removeItem {

    background-color: #FFFFFF;

    color: #6B7280;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    padding: 6px 11px;

    font-size: 13px;
}

QPushButton#removeItem:hover {

    background-color: #FEF2F2;

    color: #B42318;

    border: 1px solid #F0B4B4;
}

QPushButton#removeItem:pressed {

    background-color: #FEE2E2;
}</string>
