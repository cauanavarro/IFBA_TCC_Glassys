  <property name="styleSheet">
   <string notr="true">/* =========================================================
   PRODUCT CARD
   ========================================================= */

QFrame#productCard {
    background-color: #FFFFFF;

    border: 1px solid #DDE3E8;
    border-radius: 10px;
}


/* =========================================================
   IMAGEM DO PRODUTO
   ========================================================= */

QLabel#productImageLabel {
    background-color: #F7F8FA;

    color: #6B7280;

    border: 1px solid #EEF0F2;
    border-radius: 7px;

    font-size: 13px;
}


/* =========================================================
   NOME DO PRODUTO
   ========================================================= */

QLabel#productNameLabel {
    color: #111827;

    font-size: 15px;
    font-weight: 600;

    background-color: transparent;
    border: none;
}


/* =========================================================
   PREÇO
   ========================================================= */

QLabel#productPriceLabel {
    color: #111827;

    font-size: 17px;
    font-weight: 700;

    background-color: transparent;
    border: none;
}


/* =========================================================
   ESTOQUE
   ========================================================= */

QLabel#productStockLabel {
    color: #6B7280;

    font-size: 13px;

    background-color: transparent;
    border: none;
}


/* =========================================================
   BOTÃO ADICIONAR
   ========================================================= */

QPushButton#addProductButton {
    background-color: #FFFFFF;

    color: #374151;

    border: 1px solid #D1D5DB;
    border-radius: 6px;

    min-height: 34px;

    padding: 6px 12px;

    font-size: 13px;
    font-weight: 500;
}


/* Hover */

QPushButton#addProductButton:hover {
    background-color: #EEF4F8;

    color: #24516F;

    border: 1px solid #9FB5C5;
}


/* Pressionado */

QPushButton#addProductButton:pressed {
    background-color: #DDEAF2;

    border: 1px solid #8EAABB;
}


/* Desabilitado */

QPushButton#addProductButton:disabled {
    background-color: #F3F4F6;

    color: #9CA3AF;

    border: 1px solid #E5E7EB;
}</string>
